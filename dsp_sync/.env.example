# Copy to .env (same folder) and fill in. Never commit .env.

# --- DSP ---------------------------------------------------------------
# Include the Location/SMH columns in the export (the "With Location/SMH" option)
DSP_WITH_LOCATION=true
# Days of downloaded CSVs to keep on disk
DSP_KEEP_DAYS=30
# Optional: where the saved Cat.com sign-in lives (default: ./browser-profile)
# DSP_PROFILE_DIR=
# Optional: use an installed Chrome/Chromium instead of Playwright's
# DSP_CHROMIUM_PATH=

# --- Snowflake ---------------------------------------------------------
SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=DSP_LOADER
SNOWFLAKE_ROLE=DSP_LOADER_ROLE
SNOWFLAKE_WAREHOUSE=LOAD_WH
SNOWFLAKE_DATABASE=RAW
SNOWFLAKE_SCHEMA=DSP
SNOWFLAKE_TABLE=DSP_ASSETS
# Key-pair auth (recommended for a service user)...
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# ...or password auth (leave SNOWFLAKE_PRIVATE_KEY_PATH empty)
# SNOWFLAKE_PASSWORD=
