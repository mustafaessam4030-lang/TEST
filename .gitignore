# Editors and IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Environments and secrets
.env
.env.*
!.env.example

# Logs
*.log
# Real lookup output stays on the machine that produced it. The store's
# README is the one exception, so the folder layout is documented in git.
logs/*
!logs/sis-results/
logs/sis-results/*
!logs/sis-results/README.md
maia/logs/*
!maia/logs/sis-results/
maia/logs/sis-results/*
!maia/logs/sis-results/README.md

# Build and dependency output
build/
dist/
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/

# Test and coverage output
.coverage
coverage/
htmlcov/
.pytest_cache/

# Release archives — build artifacts, regenerate with `make package` in maya/
*.zip
