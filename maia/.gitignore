__pycache__/
*.py[cod]
.pytest_cache/
.venv/
config/.env
config/sources/*.captured.json
/var/maia/
node_modules/

artifacts/

# Local SIS credentials — never committed, never packaged
login.txt
login

# Local Claude API key — never committed, never packaged
claude.txt
claude.txt.txt

# Local Snowflake connection and keys — never committed, never packaged
snowflake.txt
snowflake.txt.txt
*.p8
keys/

# Real equipment data, screenshots and run records. Never committed,
# never packaged — but the folder's README is, so the layout is documented.
# (git cannot un-ignore a file inside an ignored DIRECTORY, so the
#  directories are walked and only the README is allowed back in)
logs/*
!logs/sis-results/
logs/sis-results/*
!logs/sis-results/README.md
