# ── Runtime ───────────────────────────────────────────────────────────────
MAIA_ENVIRONMENT=dev
MAIA_LOG_LEVEL=INFO
MAIA_REPOSITORY=memory                 # memory | snowflake
MAIA_ALLOW_LIVE_AUTOMATION=false       # master switch; nothing touches SIS until true

# ── Automation ────────────────────────────────────────────────────────────
MAIA_HEADLESS=true
MAIA_MAX_CONTEXTS=4
MAIA_RUN_DEADLINE_MS=90000
MAIA_STEP_TIMEOUT_MS=25000
MAIA_ARTIFACT_DIR=/var/maia/artifacts

# ── Snowflake (key-pair auth; no passwords) ───────────────────────────────
MAIA_SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
MAIA_SNOWFLAKE_USER=MAIA_APP
MAIA_SNOWFLAKE_ROLE=MAIA_APP
MAIA_SNOWFLAKE_WAREHOUSE=MAIA_WH
MAIA_SNOWFLAKE_DATABASE=MAIA_PROD
MAIA_SNOWFLAKE_SCHEMA=CORE
MAIA_SNOWFLAKE_PRIVATE_KEY_REF=file:///run/secrets/snowflake_key.p8

# ── SIS credentials: dev-only fallback. Production uses Vault. ────────────
# These are read by the automation worker process only. The agent process has
# no access to them, which is what makes "credentials in the prompt" impossible.
MAIA_CAT_SIS_USERNAME=
MAIA_CAT_SIS_PASSWORD=
VAULT_ADDR=
VAULT_TOKEN=

# ── Agent (separate process/pod) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
MAIA_API_BASE=http://localhost:8080
MAIA_AGENT_MODEL=claude-opus-5
