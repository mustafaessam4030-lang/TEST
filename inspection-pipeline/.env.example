# Copy to .env (never commit .env). Placeholders only.

# --- Source website ---------------------------------------------------------
SOURCE_NAME=website
COLLECTOR_TYPE=api                     # api | playwright
SOURCE_CONFIG_PATH=config/source.yaml
SOURCE_TIMEZONE=UTC                    # timezone of source timestamps without offset
WEBSITE_BASE_URL=https://inspections.example.invalid
AUTH_MODE=browser_session              # browser_session | bearer_token | none
WEBSITE_USERNAME=
WEBSITE_PASSWORD=
WEBSITE_API_TOKEN=                     # only for AUTH_MODE=bearer_token

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=30000
DIAGNOSTICS_DIR=diagnostics
MIN_EXPECTED_RECORDS=0

# --- Snowflake ----------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=                    # or key-pair below (recommended for services)
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_INSERT_BATCH_SIZE=500

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text                        # text | json
