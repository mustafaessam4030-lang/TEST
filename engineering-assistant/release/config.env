# Engineering Knowledge Assistant - settings
# Lines starting with # are comments. Restart the assistant after a change.
# Paths are relative to this folder unless you write a full path.

# Where the assistant is opened in the browser
EKA_HOST=127.0.0.1
EKA_PORT=8765
EKA_OPEN_BROWSER=1

# Phase 1: put PDFs in this folder; they are indexed automatically.
# Use a full path to point at a shared/network folder, e.g. EKA_INBOX_DIR=\\server\share\manuals
EKA_INBOX_DIR=pdfs
# How often the folder is checked (seconds)
EKA_INBOX_SCAN_S=15
# 1 = remove a document from the assistant when its PDF is deleted from the folder
EKA_INBOX_REMOVE_DELETED=0

# Library, search index, conversations and logs
EKA_DATA_DIR=data

# Search: "auto" uses the semantic model in the models folder (downloaded by setup)
EKA_EMBEDDER=auto
EKA_MODEL_DIR=models

# Answers: "extractive" quotes the documents (no AI model needed).
# To phrase answers with a local Qwen model: install Ollama, run
#   ollama pull qwen2.5:7b-instruct
# then change the next line to EKA_GENERATOR=ollama
EKA_GENERATOR=extractive
EKA_LLM_MODEL=qwen2.5:7b-instruct
EKA_OLLAMA_URL=http://127.0.0.1:11434

# OCR for scanned PDFs (Tesseract). Leave empty to find it automatically.
# EKA_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: require a password (token) to use the assistant
# EKA_API_TOKEN=change-me

EKA_MAX_UPLOAD_MB=100
EKA_LOG_LEVEL=INFO
