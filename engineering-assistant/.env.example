# Copy to .env and export (e.g. `set -a; . ./.env; set +a`) or set in your service manager.
# Every value below is the default unless marked "example".

EKA_DATA_DIR=./data
EKA_HOST=127.0.0.1
EKA_PORT=8765
# EKA_API_TOKEN=change-me            # example: require a bearer token for /api
EKA_MAX_UPLOAD_MB=100
EKA_OPEN_BROWSER=0

# Phase 1 PDF folder: indexed automatically (off disables it)
EKA_INBOX_DIR=pdfs
EKA_INBOX_SCAN_S=15
EKA_INBOX_SETTLE_S=5
EKA_INBOX_REMOVE_DELETED=0

# Embeddings: auto (semantic bge-small if already in EKA_MODEL_DIR, never downloads; else keyword-only)
#             | fastembed (downloads bge-small once, ~65 MB) | hashing (keyword-only) | ollama
EKA_EMBEDDER=auto
# EKA_EMBED_MODEL=BAAI/bge-small-en-v1.5
# EKA_MODEL_DIR=./data/models

# Answers: extractive (no LLM) | ollama
EKA_GENERATOR=extractive
EKA_LLM_MODEL=qwen2.5:7b-instruct
EKA_OLLAMA_URL=http://127.0.0.1:11434
EKA_LLM_TIMEOUT_S=120
EKA_LLM_RETRIES=1

EKA_OCR_ENABLED=1
EKA_OCR_DPI=300
EKA_OCR_LANG=eng
# EKA_TESSERACT_CMD=/usr/bin/tesseract   # example; found on PATH / Windows default folders otherwise

EKA_TOP_K=6
EKA_LOG_LEVEL=INFO
EKA_LOG_QUERY_TEXT=0
