# ── Runtime ───────────────────────────────────────────────────────────────
MAYA_ENVIRONMENT=dev
MAYA_LOG_LEVEL=INFO
MAYA_REPOSITORY=memory                 # memory | snowflake
MAYA_ALLOW_LIVE_AUTOMATION=false       # master switch; nothing touches SIS until true

# ── Automation ────────────────────────────────────────────────────────────
MAYA_HEADLESS=true
MAYA_MAX_CONTEXTS=4
MAYA_RUN_DEADLINE_MS=90000
MAYA_STEP_TIMEOUT_MS=25000
MAYA_ARTIFACT_DIR=/var/maya/artifacts

# ── Snowflake (key-pair auth; no passwords) ───────────────────────────────
MAYA_SNOWFLAKE_ACCOUNT=xy12345.eu-west-1
MAYA_SNOWFLAKE_USER=MAYA_APP
MAYA_SNOWFLAKE_ROLE=MAYA_APP
MAYA_SNOWFLAKE_WAREHOUSE=MAYA_WH
MAYA_SNOWFLAKE_DATABASE=MAYA_PROD
MAYA_SNOWFLAKE_SCHEMA=CORE
MAYA_SNOWFLAKE_PRIVATE_KEY_REF=file:///run/secrets/snowflake_key.p8

# ── SIS credentials: dev-only fallback. Production uses Vault. ────────────
# These are read by the automation worker process only. The agent process has
# no access to them, which is what makes "credentials in the prompt" impossible.
MAYA_CAT_SIS_USERNAME=
MAYA_CAT_SIS_PASSWORD=
VAULT_ADDR=
VAULT_TOKEN=

# ── Agent (separate process/pod) ──────────────────────────────────────────
ANTHROPIC_API_KEY=
MAYA_API_BASE=http://localhost:8080
MAYA_AGENT_MODEL=claude-opus-5
