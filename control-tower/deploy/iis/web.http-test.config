<?xml version="1.0" encoding="UTF-8"?>
<!--
  ATA Control Tower behind IIS - HTTP TEST ONLY, before the certificate.
  No redirect to https and no HSTS; setup_iis.ps1 -HttpOnly installs it.
  Run setup_iis.ps1 again with -CertThumbprint to switch to https.

  IIS answers https://<your domain> and forwards every request to the tower on
  this same server at http://127.0.0.1:8787. Nothing else is served from here.
  setup_iis.ps1 copies this file into the site folder; see README_FOR_IT.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Everything else goes to the tower. -->
        <rule name="ATA: forward to the tower" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!--
      The live dashboard is a server-sent event stream (/api/stream).
      Compression would hold it back until a buffer fills, and the page would
      stop updating, so dynamic compression is off for this site.
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <!-- Screenshots attached in ATLAS chat are at most a few MB. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
