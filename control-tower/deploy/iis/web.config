<?xml version="1.0" encoding="UTF-8"?>
<!--
  ATA Control Tower behind IIS (URL Rewrite + Application Request Routing).

  IIS answers https://<your domain> and forwards every request to the tower on
  this same server at http://127.0.0.1:8787. Nothing else is served from here.
  setup_iis.ps1 copies this file into the site folder; see README_FOR_IT.md.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Plain http only ever redirects to https. -->
        <rule name="ATA: http to https" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Everything else goes to the tower. -->
        <rule name="ATA: forward to the tower" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8787/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!--
      The live dashboard is a server-sent event stream (/api/stream).
      Compression would hold it back until a buffer fills, and the page would
      stop updating, so dynamic compression is off for this site.
    -->
    <!--
      The tower's own error replies (401 "sign in again", 403, 404, 413) are
      JSON the dashboard reads. Without this IIS swaps them for its error pages.
    -->
    <httpErrors existingResponse="PassThrough" />
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />
    <!-- Screenshots attached in ATLAS chat are at most a few MB. -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>
    <httpProtocol>
      <customHeaders>
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
