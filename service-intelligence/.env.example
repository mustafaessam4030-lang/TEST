# Copy to .env (never commit it) or set in the service manager / secret store.
SI_ENV=dev                      # dev | test | prod   (prod refuses synthetic data and dev auth)
SI_BACKEND=fixture              # fixture (SYNTHETIC data) | snowflake
SI_AUTH_MODE=dev                # dev (SI_ENV=dev only) | token | trusted_header
SI_USERS_PATH=config/users.example.yaml
SI_REPORTING_TZ=UTC             # IANA name, e.g. Africa/Cairo
SI_HOST=127.0.0.1
SI_PORT=8780
SI_DATA_DIR=./data              # query log and the dev plan database

# Query controls
SI_QUERY_TIMEOUT_S=60
SI_MAX_ROWS=5000
SI_DRILLDOWN_PAGE=100
SI_CACHE_TTL_S=300

# --- Snowflake (SI_BACKEND=snowflake) ---
# SI_CONTRACT_VIEW=<SI_DB>.<SERVICE_INTEL>.V_SERVICE_REQUESTS
# SI_MAPPING_PATH=config/source_mapping.yaml
# SNOWFLAKE_ACCOUNT=<org-account>
# SNOWFLAKE_USER=<SI_SVC>
# SNOWFLAKE_ROLE=<SI_READER>
# SNOWFLAKE_WAREHOUSE=<SI_WH>
# SNOWFLAKE_PRIVATE_KEY_PATH=/run/secrets/si_snowflake_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=          # from the secret store
# SNOWFLAKE_AUTHENTICATOR=externalbrowser    # dev only, instead of a key
# SI_SNOWFLAKE_WRITER_ROLE=<SI_PLAN_WRITER>
# SI_APP_SCHEMA=<SI_DB>.SI_APP

# --- Optional Snowflake Cortex question planner ---
SI_CORTEX_ENABLED=0
# SI_CORTEX_MODEL=mistral-large2

# Live tests (read-only) against Snowflake
# RUN_SNOWFLAKE_TESTS=1
